# SEGREDOS — nunca versionar.
#   .env       lido pelo site (Vite) e por scripts/subir-api.mjs
#   .dev.vars  lido pela API em desenvolvimento (wrangler dev)
# Tem senha do banco e chave de serviço do Supabase. Vazou, troque.
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example

# Crachás de sessão reusados por scripts de prova. São sessões de verdade.
.sessao-de-prova
.sessao-renovacao
.sessao-da-volta
.sessao-da-carga

# Rascunhos de scripts que leem o .env
scripts/_tmp-*

# Saídas locais de medição e conferência visual
capturas/
carga-*.json
scripts/saida/

# Temporários do Supabase CLI
supabase/.temp/
supabase/.branches/

# Duplicatas do Finder/iCloud (já quebraram um deploy: a pasta da API apareceu
# com cada módulo em dobro, com sufixo " 2")
* 2.*
* 2
*[0-9] copy.*
* copy.*
* cópia.*

# Sobras de merge
*.orig
*.rej
*.bak
*~
