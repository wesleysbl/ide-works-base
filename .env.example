# Copie para .env e preencha. O .env NUNCA vai para o git.
# Passo a passo: docs/tutoriais/02-configurar-o-supabase.md e 03-rodar-no-computador.md
#
# CONVENÇÃO DE NOME QUE EVITA VAZAMENTO
#   IDEWORKS_PUBLIC_*  -> vai para o pacote do navegador. NUNCA ponha segredo aqui.
#   IDEWORKS_SERVER_*  -> só no servidor. O empacotador não enxerga.
# O Vite exporta SOMENTE o prefixo PUBLIC, e um teste quebra a construção se um
# segredo escapar para o pacote.

# --- público (vai para o navegador) -------------------------------------------
# A trava de schema RECUSA subir se isto não for exatamente "ideworks".
IDEWORKS_PUBLIC_DB_SCHEMA=ideworks
# Supabase → Project Settings → API Keys (URL do projeto e a chave "anon").
IDEWORKS_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
IDEWORKS_PUBLIC_SUPABASE_ANON_KEY=

# --- segredo (nunca sai do servidor) ------------------------------------------
# O papel restrito criado pelas migrations: só alcança o schema ideworks.
# A senha é a que você definiu no passo 3 do tutorial do Supabase.
IDEWORKS_SERVER_DB_USER=ideworks_app
IDEWORKS_SERVER_DB_PASSWORD=
# O endereço do "Transaction pooler" do seu projeto (Supabase → botão Connect →
# Transaction pooler). Só o host, sem porta. Ex.: aws-0-sa-east-1.pooler.supabase.com
IDEWORKS_SERVER_DB_HOST=

# Senha das contas fixas de verificação (scripts de prova), em @ideworks.invalid.
# Opcional: só para quem roda os scripts que entram com uma conta de teste.
IDEWORKS_TEST_ACCOUNT_PASSWORD=

# A chave de serviço do Supabase (service_role / secret).
#   Necessária para CONVIDAR pessoas (cria a conta no Supabase Auth) e para os
#   ANEXOS (o balde `ideworks-anexos` é privado, e só ela alcança os arquivos).
#   Quem decide o que cada pessoa vê continua sendo o banco: o servidor confere
#   o acesso antes de cada ida ao Storage, e só então usa a chave.
# ⚠️ Ela dá acesso total ao projeto. Nunca renomeie para IDEWORKS_PUBLIC_.
IDEWORKS_SERVER_SUPABASE_SERVICE_KEY=
